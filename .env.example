# Copy this file to .env and edit the values before running `docker compose up`.
# Full description of every variable: README.md > Configuration (or README.fr.md > Configuration).

# ── Authentication ───────────────────────────────────────────────────────────
# API access password. Strongly recommended: set your own value here.
# If missing or empty, the server generates a strong password at EVERY startup and
# prints it in the console/logs (there is no "no auth" mode).
# CHANGE THIS before deploying — do not keep the example value.
EZDL_PASSWORD=change-me-please

# ── Network ──────────────────────────────────────────────────────────────────
EZDL_HOST=0.0.0.0
EZDL_PORT=8000

# ── Storage ──────────────────────────────────────────────────────────────────
# Allowed download destinations, format "Label=/path,Label2=/path2".
# Only these roots (and their subfolders) are writable by the server.
# A root must never contain — or be contained in — EZDL_DATA_DIR or EZDL_EXTENSION_DIST_DIR:
# a download would then be able to overwrite the extension signing key or the published zip,
# which the server signs as-is. The server refuses to start in that case.
EZDL_DOWNLOAD_ROOTS=Downloads=/data/downloads

# Where the SQLite database and app state are stored. Also holds the extension signing key
# and the signed .crx cache: keeping this directory persistent is what keeps the published
# extension's Chrome ID stable across rebuilds (a new ID would look like a different
# extension instead of an update).
EZDL_DATA_DIR=/config

# Where the build dropped the packaged extension (zip + version), served at /extension.
# Only change this if you build the image outside the provided docker-compose.yml.
EZDL_EXTENSION_DIST_DIR=/app/extension-dist

# Scratch space for in-progress downloads before they're moved to their final folder.
# Mounted on the persistent `ezdl-temp` volume by docker-compose.yml: partial files must
# survive a restart for interrupted downloads to be resumable instead of restarted.
EZDL_TEMP_DIR=/tmp/ez-dl

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Number of concurrent download/convert jobs.
EZDL_MAX_CONCURRENT_JOBS=2

# ── Server auto-update (host-side) ───────────────────────────────────────────
# Read by deploy/auto-update.sh (run it from cron/systemd on the host, NOT in the
# container): when "true", the script pulls the tracked branch and rebuilds the
# `server` service whenever origin has new commits. Anything else disables it.
EZDL_AUTO_UPDATE=false

# ── External binaries ────────────────────────────────────────────────────────
# How often yt-dlp self-updates, in hours (0 disables the periodic check).
EZDL_YTDLP_UPDATE_INTERVAL_HOURS=24

# Override only if the binary isn't on PATH.
EZDL_YTDLP_BINARY=yt-dlp
EZDL_FFMPEG_BINARY=ffmpeg

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
EZDL_CORS_ORIGINS=chrome-extension://*

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: debug | info | warning | error
EZDL_LOG_LEVEL=info
