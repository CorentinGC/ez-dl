# Copy this file to .env and edit the values before running `docker compose up`.
# Full description of every variable: README.md > Configuration (or README.fr.md > Configuration).

# ── Authentication ───────────────────────────────────────────────────────────
# API access password. Strongly recommended: set your own value here.
# If missing or empty, the server generates a strong password at EVERY startup and
# prints it in the console/logs (there is no "no auth" mode).
# CHANGE THIS before deploying — do not keep the example value.
EZDL_PASSWORD=change-me-please

# ── Network ──────────────────────────────────────────────────────────────────
EZDL_HOST=0.0.0.0
EZDL_PORT=8000

# ── Runtime identity ─────────────────────────────────────────────────────────
# uid/gid the server runs as inside the container. Set them to the OWNER of your media
# volumes (`id -u` / `id -g` on the host, or the owner of the share on a NAS).
# Applied when the container starts, so the published image works as-is on a host whose
# user is not 1000 — no rebuild needed. PUID=0 is refused.
PUID=1000
PGID=1000

# ── Storage ──────────────────────────────────────────────────────────────────
# Allowed download destinations, format "Label=/path,Label2=/path2".
# Only these roots (and their subfolders) are writable by the server.
# A root must never contain — or be contained in — EZDL_DATA_DIR or EZDL_EXTENSION_DIST_DIR:
# a download would then be able to overwrite the extension signing key or the published zip,
# which the server signs as-is. The server refuses to start in that case.
EZDL_DOWNLOAD_ROOTS=Downloads=/data/downloads

# Where the SQLite database and app state are stored. Also holds the extension signing key
# and the signed .crx cache: keeping this directory persistent is what keeps the published
# extension's Chrome ID stable across rebuilds (a new ID would look like a different
# extension instead of an update).
EZDL_DATA_DIR=/config

# Where the build dropped the packaged extension (zip + version), served at /extension.
# Only change this if you build the image outside the provided docker-compose.yml.
EZDL_EXTENSION_DIST_DIR=/app/extension-dist

# Public base URL of this server, as a browser sees it — only needed behind a reverse proxy,
# where the host and scheme uvicorn sees are not the client's. /extension/update.xml publishes
# an absolute .crx download URL, and Chrome must be able to reach it. Leave empty to derive it
# from the incoming request. Chrome requires https for that URL on the system-policy path.
# EZDL_PUBLIC_URL=https://ez-dl.example.com

# Scratch space for in-progress downloads before they're moved to their final folder.
# Mounted on the persistent `ezdl-temp` volume by docker-compose.yml: partial files must
# survive a restart for interrupted downloads to be resumable instead of restarted.
EZDL_TEMP_DIR=/tmp/ez-dl

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Number of concurrent download/convert jobs.
EZDL_MAX_CONCURRENT_JOBS=2

# ── Server auto-update ───────────────────────────────────────────────────────
# Recommended path — fully inside the Docker stack: uncomment the line below to start
# the bundled watchtower service, which pulls the CI-published image
# (ghcr.io/corentingc/ez-dl:latest) and recreates the server automatically.
# `latest` follows TAGGED RELEASES only, not every commit on main — set EZDL_IMAGE to
# ...:edge below if you want to track main instead.
# Only for deployments running the published image (plain `docker compose up -d`,
# no --build). See docs/*/decisions/0005-auto-update-image-ghcr-watchtower.md,
# amended by 0006-versionnement-et-canaux-de-publication.md.
#COMPOSE_PROFILES=autoupdate

# Registry poll period for watchtower, in seconds.
EZDL_AUTO_UPDATE_INTERVAL_SECONDS=300

# Image the compose file runs. Override to pin a version (`:0.1.0`, `:0.1`), to follow
# main instead of releases (`:edge`, `:main-<sha>`), or to use a fork.
#EZDL_IMAGE=ghcr.io/corentingc/ez-dl:latest

# Alternative path for hosts that BUILD locally (GPU/NVENC variant): set to
# "true" and schedule deploy/auto-update.sh from cron/systemd on the host — it pulls
# the tracked branch and rebuilds the `server` service when origin moves. Do not
# combine with the watchtower profile (it would downgrade local builds).
EZDL_AUTO_UPDATE=false

# ── External binaries ────────────────────────────────────────────────────────
# How often yt-dlp self-updates, in hours (0 disables the periodic check).
EZDL_YTDLP_UPDATE_INTERVAL_HOURS=24

# Override only if the binary isn't on PATH.
EZDL_YTDLP_BINARY=yt-dlp
EZDL_FFMPEG_BINARY=ffmpeg

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
EZDL_CORS_ORIGINS=chrome-extension://*

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: debug | info | warning | error
EZDL_LOG_LEVEL=info
